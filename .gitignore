__pycache__/
*.pyc
.DS_Store
*.log

# Large, regenerable benchmark data (re-download — see docs/PROGRESS.md "Data").
eval/data/spreadsheet/
# MATH raw HuggingFace parquet sources (re-fetchable binaries; the extracted *.jsonl task
# files under eval/data/math/ and math_*val.jsonl ARE tracked, like searchqa_val.jsonl).
eval/data/math_hf/

# Per-run working dirs (transcripts/ledgers): bulky + reproducible.
# We KEEP the results of record: tasks.jsonl, curve.csv, summary.json, *.svg.
results/*/runs/*/home/
results/**/home/                 # deeper nesting (e.g. per-family: results/<exp>/<family>/runs/*/home/)

# Scratch / de-risking runs (pilots, smokes, A/B diagnostics) — not results of record.
results/_*/

# Promoted skills are a real engine/skills dir; .claude/skills is a generated symlink.
engine/.claude/skills

# Per-deployment evolving state (uncomment to keep memory local-only)
# memory/store.jsonl
# memory/skill_state.json
# memory/skill_candidates/
